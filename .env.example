# ==============================================================================
# BUBUBAI Multi-Provider AI Fallback Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Primary Provider: Google Gemini
# ------------------------------------------------------------------------------
# Required for primary responses. Free tier provides high throughput.
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional: Gemini model override (defaults to gemini-2.5-flash)
# Supported models: gemini-2.5-flash, gemini-3.8-flash
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# First Fallback Provider: NVIDIA NIM (Free / Fast Inference)
# ------------------------------------------------------------------------------
# Used automatically when Google Gemini hits 429 quota exhaustion or downtime.
# Get free API credits at: https://build.nvidia.com
NVIDIA_API_KEY="nvapi-your_nvidia_api_key_here"

# Optional: NVIDIA NIM model override
# Defaults to: meta/llama-3.3-70b-instruct
# Supported models:
#   - meta/llama-3.3-70b-instruct (Recommended for coding and conversational depth)
#   - nvidia/llama-3.1-nemotron-70b-instruct (High precision reasoning)
#   - mistralai/mistral-large-2-instruct
#   - deepseek-ai/deepseek-r1
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"

# ------------------------------------------------------------------------------
# Second Fallback Provider: OpenAI (Optional Paid Reserve)
# ------------------------------------------------------------------------------
# Cost Control Notice: OpenAI is a paid provider.
# To prevent unexpected charges, OpenAI is DISABLED by default unless both
# OPENAI_API_KEY is provided AND OPENAI_ENABLED is explicitly set to true.
OPENAI_API_KEY="sk-your_openai_api_key_here"
OPENAI_ENABLED="false"

# Optional: OpenAI model override (defaults to gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# Provider Orchestrator Settings
# ------------------------------------------------------------------------------
# Order of fallback attempts (comma-separated):
PROVIDER_PRIORITY="gemini,nvidia,openai"

# Timeout per provider attempt in milliseconds (default: 15000 = 15s)
PROVIDER_TIMEOUT_MS="15000"

# Maximum characters allowed per chat prompt
MAX_MESSAGE_LENGTH="4000"

# Rate limiting: Maximum requests per minute per IP
RATE_LIMIT_MAX_REQUESTS="30"
RATE_LIMIT_WINDOW_MS="60000"

# App URL for callbacks and metadata
APP_URL="https://your-domain.vercel.app"
